// Scrape the private postgres-exporter sidecar and forward the converted
// metrics to Grafana Cloud. Credentials are injected only as runtime env vars.
prometheus.scrape "postgres" {
  targets = [{ "__address__" = "127.0.0.1:9187" }]

  scrape_interval = "15s"
  forward_to      = [otelcol.receiver.prometheus.postgres.receiver]
}

// Pull broker-level signals from Azure Monitor. Application telemetry cannot
// observe retries or dead letters that happen before/after the webhook call.
prometheus.exporter.azure "eventgrid" {
  subscriptions = [sys.env("AZURE_SUBSCRIPTION_ID")]
  resource_type = "Microsoft.EventGrid/topics"
  resource_graph_query_filter = "| where tags['application'] == 'dnd-campaign-manager'"
  metrics = [
    "PublishSuccessCount",
    "PublishFailCount",
    "MatchedEventCount",
    "DeliverySuccessCount",
    "DeliveryAttemptFailCount",
    "DeadLetteredCount",
    "DroppedEventCount",
    "DestinationProcessingDurationInMs",
  ]
  included_dimensions = [
    "EventSubscriptionName",
    "Error",
    "ErrorType",
    "DeadLetterReason",
    "DropReason",
  ]
  included_resource_tags = ["application", "environment"]
  timespan = "PT15M"
  interval = "PT1M"
}

prometheus.scrape "eventgrid" {
  targets         = prometheus.exporter.azure.eventgrid.targets
  scrape_interval = "1m"
  forward_to      = [otelcol.receiver.prometheus.postgres.receiver]
}

otelcol.receiver.prometheus "postgres" {
  output {
    metrics = [otelcol.processor.batch.postgres.input]
  }
}

otelcol.processor.batch "postgres" {
  timeout = "5s"

  output {
    metrics = [otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GRAFANA_CLOUD_OTLP_ENDPOINT")
    headers = {
      "Authorization" = sys.env("GRAFANA_CLOUD_AUTHORIZATION"),
    }
  }
}
