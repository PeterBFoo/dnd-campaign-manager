# Exclusivamente para desarrollo local. No reutilizar en despliegues.
POSTGRES_DB=dnd_campaigns
POSTGRES_USER=dnd_app
POSTGRES_PASSWORD=change-me-local-postgres
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-grafana

# Opcionales hasta habilitar invitaciones. Nunca versionar la clave ni el remitente reales.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=D&D Campaign Manager

# Identidad local. En producción deben ser secretos independientes y aleatorios.
IDENTITY_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
# Clave de 32 bytes codificada en Base64: openssl rand -base64 32
OUTBOX_ENCRYPTION_KEY=

# Event Grid se deja desactivado en local; en Azure son valores de configuración no secreta.
EVENTGRID_ENABLED=false
EVENTGRID_TOPIC_ENDPOINT=
EVENTGRID_TENANT_ID=
EVENTGRID_AUDIENCE=
